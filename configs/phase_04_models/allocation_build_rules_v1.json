  "units": {
    "portfolio_weights": "fraction_of_current_nav",
    "expected_residual_return": "decimal_monthly_return",
    "covariance": "decimal_monthly_return_covariance",
    "factor_variance": "decimal_monthly_return_variance",
    "transaction_borrow_and_financing_costs": "decimal_monthly_return",
    "factor_exposures": "return_beta",
    "daily_to_monthly_covariance_multiplier": 21.0,
    "monthly_periods_per_year": 12.0,
    "trading_sessions_per_year": 252.0
  },
  "candidate_formation": {
    "score_population": "contemporaneous_long_eligible_scoring_universe",
    "long_entry_tail": "top_centered_monthly_score_quintile",
    "long_entry_boundary_quantile": 0.80,
    "short_entry_tail": "bottom_centered_monthly_score_tail_after_short_eligibility",
    "short_entry_boundary_quantile_from_full_scoring_population": 0.20,
    "minimum_new_names_each_side": 50,
    "tail_extension_rule": "scan_from_most_extreme_score_until_50_disjoint_valid_names_if_the_eligible_tail_is_smaller",
    "score_tie_break": "permno_ascending",
    "candidate_sets_must_be_disjoint": true,
    "disjoint_assignment_rule": "lock_valid_positional_tail_names_then_fill_alternating_long_short_slots_with_deterministic_score_permno_ordered_augmenting_paths",
    "insufficient_either_side_rule": "take_no_new_risk_and_reduce_existing_risk_subject_to_trade_limits",
    "long_candidate_sign": "weight_greater_than_or_equal_to_zero",
    "short_candidate_sign": "weight_less_than_or_equal_to_zero",
    "off_tail_or_ineligible_holding_rule": "fixed_sign_reduction_only_absolute_target_not_above_pretrade_absolute_weight",
    "tradable_failed_screen_holding_target": "zero_as_position_cap_target_subject_to_turnover_and_10_percent_adv",
    "all_cash_empty_selection_rule": "represent_as_zero_asset_problem_and_bypass_conic_solver_with_100_percent_cash",
    "nonfinite_ineligible_reduction_only_score_or_alpha_rule": "neutralize_to_zero_only_for_selected_noneligible_reduction_only_rows",
    "one_rebalance_sign_reversal_permitted": false,
    "forced_holding_count_permitted": false,
    "forced_leg_gross_permitted": false,
    "missing_current_risk_carry_sessions": 21,
    "post_carry_missing_risk_rule": "retain_last_valid_betas_replace_specific_variance_with_contemporaneous_type7_95th_percentile_and_continue_reduction",
    "unknown_sector_bucket": "UNKNOWN_SECTOR",
    "unknown_foreign_bucket": "UNKNOWN_FOREIGN",
    "unknown_country_bucket": "UNKNOWN_COUNTRY",
    "unknown_country_counts_as_foreign": true,
    "mandatory_corporate_action_handoff": "apply_recorded_payoff_and_update_positions_nav_in_upstream_return_accounting_before_allocator_input"
  },
  "architectures": {
    "confirmatory_primary": {
      "id": "hybrid_alpha_risk_cost_convex",
      "role": "confirmatory_primary_fixed_before_validation",
      "expected_return_input": "calibrated_expected_residual_return_mu_hat",
      "objective": "maximize(mu_hat_transpose_w - transaction_cost(delta_w) - borrow_cost(w) - financing_cost(w))",
      "risk_aversion_bisection_permitted": false,
      "challenger_may_replace_primary": false,
      "cash_permitted": true,
      "zero_portfolio_feasible_from_cash": true
    },
    "rank_based_challenger": {
      "id": "rank_volatility_projected",
      "role": "challenger_only",
      "forecast_volatility": "sqrt(monthly_covariance_diagonal)",
      "long_raw_strength": "max(score-q80,0)/forecast_volatility",
      "short_raw_strength": "max(q20-score,0)/forecast_volatility",
      "invalid_or_nonpositive_volatility_rule": "not_a_new_candidate",
      "leg_normalization": "normalize_long_and_short_raw_strength_separately_to_equal_unit_absolute_notional",
      "preprojection_scale": "min(1,0.10/sqrt(augmented_annual_variance_of_two_gross_raw_portfolio))",
      "preprojection_gross_cap": 2.0,
      "zero_strength_or_nonfinite_scale_rule": "take_no_new_risk_and_reduce_existing_risk",
      "final_projection": "common_cap_scaled_minimum_distance_conic_projection"
    },
    "decision_focused_ml_challenger": {
      "id": "decision_focused_neural_projected",
      "role": "experimental_challenger_only",
      "security_inputs": [
        "frozen_ensemble_score",
        "six_beta_risk_values",
        "forecast_volatility",
        "liquidity",
        "constrained_sector_indicators",
        "constrained_country_indicators",
        "current_holding"
      ],
      "shared_hidden_layers": [32, 16],
      "activation": "relu",
      "dropout": 0.10,
      "optimizer": "adam",
      "learning_rate": 0.001,
      "maximum_epochs": 200,
      "early_stopping_patience": 20,
      "early_stopping_latest_completed_months": 24,
      "seeds": [11, 23, 47, 71, 101],
      "architecture_or_penalty_grid_permitted": false,
      "shared_trunk_outputs_per_security": [
        "allocation_logit",
        "long_gate_logit_contribution",
        "short_gate_logit_contribution"
      ],
      "long_gate_pooling": "arithmetic_mean_of_long_gate_logit_contribution_over_fixed_sign_long_candidate_leg_then_sigmoid",
      "short_gate_pooling": "arithmetic_mean_of_short_gate_logit_contribution_over_fixed_sign_short_candidate_leg_then_sigmoid",
      "gate_pooling_is_permutation_invariant": true,
      "empty_leg_gate": 0.0,
      "cross_section_outputs": "two_leg_gross_gates_each_bounded_from_zero_to_one_nav",
      "within_leg_allocation": "softmax_over_each_fixed_sign_candidate_set",
      "raw_gross_maximum": 2.0,
      "either_gross_gate_may_be_zero": true,
      "cash_permitted": true,
      "projection": "common_cap_scaled_minimum_distance_conic_projection",
      "training_sequence": "complete_chronological_sequence_starting_in_cash",
      "prior_holding_input": "previous_month_projected_weight_with_gradient_stopped",
      "training_loss": "negative_sqrt12_times_mean_net_excess_return_divided_by_sqrt(population_variance_net_excess_return_plus_1e-8)",
      "loss_variance_ridge": 1e-8,
      "epoch_refit_rule": "after_early_stopping_refit_full_permitted_history_for_selected_epoch_count",
      "seed_combination": "average_seed_specific_projected_weights_then_project_once_more",
      "scheduled_update": "quarterly_weighted_expanding_with_10_year_half_life",
      "training_return_accounting": "daily_fixed_share_weight_drift_with_daily_risk_free_borrow_and_financing_accrual_and_one_time_rebalance_transaction_cost",
      "training_projection_infeasibility_rule": "fail_closed_and_report_challenger_inactive",
      "training_zero_capacity_rule": "replace_scs_fixed_coordinate_with_stopped_exact_pretrade_weight_before_cost_and_feasibility_audit",
      "inference_rule": "evaluation_mode_project_each_seed_with_CLARABEL_average_then_project_final_average_with_CLARABEL",
      "approximate_unconstrained_fallback_permitted": false,
      "unsupported_differentiable_layer_rule": "report_challenger_inactive"
    }
  },
  "common_projection": {
    "objective": "0.5*sum(((w-raw_w)/applicable_position_cap)^2)+1e-8*sum(w^2)",
    "strict_convexity_ridge": 1e-8,
    "long_cap_scale": 0.0100,
    "short_cap_scale": 0.0075,
    "enforce_fixed_signs": true,
    "enforce_all_hard_constraints": true,
    "enforce_augmented_risk_budget": true,
    "enforce_trade_limits": true,
    "training_layer": "CVXPYLayers_via_diffcp_and_SCS",
    "training_layer_output_requires_independent_feasibility_gate": true,
    "deterministic_inference_solver": "CLARABEL",
    "final_executed_weight_must_use_deterministic_inference_solver": true
  },
  "risk_budget": {
    "annualized_augmented_volatility_limit": 0.10,
    "annualized_augmented_variance_limit": 0.01,
    "formula": "12*(w_transpose_Sigma_monthly_w + 4*sigma_market_monthly_squared*(beta_market_transpose_w)^2)",
    "market_beta_soft_multiplier_increment": 4.0,
    "approximate_total_market_risk_weight": 5.0,
    "soft_beta_center": 0.0,
    "ordinary_covariance_market_component_retained": true,
    "authoritative_inputs": "factor_betas_factor_covariance_monthly_specific_variance_monthly",
    "risk_root_rule": "derive_internally_never_accept_caller_supplied_root",
    "market_variance_rule": "must_equal_factor_covariance_mktrf_diagonal",
    "rank_forecast_volatility_rule": "must_equal_sqrt_diagonal_of_B_F_B_transpose_plus_D_without_soft_market_increment"
  },
  "hard_constraints": {
    "gross_exposure_maximum": 2.0,
    "dynamic_net_absolute_nav_maximum": 0.10,
    "dynamic_net_absolute_gross_fraction_maximum": 0.05,
    "dynamic_net_linear_inequalities": [
      "-0.10 <= long_gross-short_gross",
      "long_gross-short_gross <= 0.10",
      "0.95*long_gross <= 1.05*short_gross",
      "0.95*short_gross <= 1.05*long_gross"
    ],
    "issuer_long_weight_maximum": 0.0100,
    "issuer_short_weight_minimum": -0.0075,
    "market_beta_absolute_maximum": 0.10,
    "other_factor_order": ["smb", "hml", "rmw", "cma", "umd"],
    "each_other_factor_beta_absolute_maximum": 0.10,
    "sector_net_absolute_maximum": 0.05,
    "sector_gross_maximum": 0.30,
    "each_non_us_country_net_absolute_maximum": 0.05,
    "aggregate_foreign_issuer_net_absolute_maximum": 0.10,
    "one_way_monthly_turnover_maximum": 0.50,
    "one_way_turnover_formula": "0.5*sum(abs(target_weight-pretrade_weight))",
    "each_trade_adv_fraction_maximum": 0.10,
    "trade_adv_formula": "abs(delta_weight)*current_nav <= 0.10*adv20_usd",
    "trade_capacity_input_rule": "effective_capacity_may_be_stricter_but_must_not_exceed_recomputed_10_percent_adv_over_nav",
    "minimum_gross_required": false,
    "forced_investment_required": false,
    "fixed_cardinality_required": false,
    "exact_dollar_neutrality_required": false,
    "exact_beta_zero_required": false,
    "forced_positive_net_required": false
  },
  "transaction_cost_model": {
    "formula": "abs(delta_weight)*(spread_multiplier*full_spread/2 + 0.0001 + impact_coefficient*sigma_daily*sqrt(abs(delta_weight)*current_nav/adv20_usd))",
    "full_spread_source": "verified_stage08_full_spread_input",
    "adv_source": "verified_stage08_trailing_20_session_median_dollar_volume",
    "impact_volatility_source": "verified_stage08_decimal_daily_impact_volatility",
    "new_trade_missing_input_rule": "prohibit_if_spread_missing_or_adv_missing_or_nonpositive_or_impact_volatility_missing",
    "commission_and_operational_slippage_rate": 0.0001,
    "reference_nav_usd": 100000000.0,
    "nav_sensitivity_usd": [25000000.0, 500000000.0],
    "scenarios": {
      "primary": {"spread_multiplier": 1.0, "impact_coefficient": 0.10},
      "standard_cost_stress": {"spread_multiplier": 2.0, "impact_coefficient": 0.20},
      "severe_impact_only": {"spread_multiplier": 1.0, "impact_coefficient": 0.50}
    },
    "stage10_execution": "encode_and_test_only_no_empirical_cost_or_trade_output"
  },
  "borrow_model": {
    "positive_short_notional": "max(-weight,0)",
    "primary_annual_rate": 0.01,
    "stress_regular_annual_rate": 0.03,
    "stress_lowest_liquidity_quintile_annual_rate": 0.10,
    "stress_10_percent_is_total_not_additive": true,
    "optimizer_monthly_conversion": "annual_rate/12",
    "liquidity_rank": "ascending_adv20_then_permno",
    "missing_or_nonpositive_adv_rule": "rank_as_lowest_liquidity_then_permno",
    "lowest_liquidity_quintile_formula": "floor(5*zero_based_rank/N)+1",
    "stage10_and_later_rank_population": "current_short_candidates_union_current_short_holdings",
    "rate_mapping_rule": "derive_inside_allocator_from_stage10_union_quintile_and_scenario_never_accept_caller_supplied_rate",
    "historical_locate_recall_or_squeeze_availability_claim_permitted": false
  },
  "financing_model": {
    "primary_annual_spread": 0.005,
    "stress_annual_spread": 0.015,
    "charged_notional": "max(gross_exposure-1,0)",
    "optimizer_monthly_conversion": "annual_rate/12"
  },
  "ordinary_and_emergency_solver_flow": {
    "ordinary_first_attempt": "CLARABEL_primary_tolerances",
    "ordinary_retry": "same_problem_same_CLARABEL_with_retry_tolerances",
    "economic_objective_numerical_scale_basis_points": 10000.0,
    "alternate_forward_solver_permitted": false,
    "inaccurate_or_user_limit_status_accepted": false,
    "emergency_entry_requires": "both_ordinary_objective_attempts_fail_then_identical_constraint_feasibility_retry_returns_exact_infeasible_and_unchanged_pretrade_portfolio_is_independently_verified_under_emergency_hard_rules",
    "always_hard_in_emergency": [
      "fixed_signs",
      "reduction_only_no_increase_rules",
      "one_way_turnover_limit",
      "10_percent_adv_trade_limits"
    ],
    "mandatory_corporate_action_is_only_trade_limit_exception": true,
    "mandatory_corporate_action_allocator_input_rule": "must_already_be_resolved_by_upstream_accounting_and_is_rejected_if_pending",
    "slack_permitted_only_for_inherited_violations": [
      "gross",
      "dynamic_net",
      "position_cap",
      "augmented_risk",
      "market_and_other_factor_beta",
      "sector",
      "country"
    ],
    "slack_normalization": "constraint_excess_divided_by_stated_limit; augmented_risk_excess_variance_divided_by_0.01",
    "required_exit_slack_convention": "zero_target_is_a_position_cap_subtype_normalized_by_applicable_1_percent_long_or_0.75_percent_short_cap",
    "previously_satisfied_constraint_slack_maximum": 0.0,
    "posttrade_normalized_violation_may_exceed_pretrade": false,
    "lexicographic_steps": [
      "minimize_maximum_normalized_violation",
      "hold_step1_optimum_and_minimize_sum_normalized_violations",
      "hold_step1_and_step2_optima_and_maximize_net_alpha_minus_cost"
    ],
    "challenger_emergency_final_objective": "same_net_alpha_minus_transaction_borrow_financing_cost_as_frozen_fallback_not_projection_distance",
    "ordinary_numerical_failure_without_exact_infeasibility": "fail_closed_without_slack",
    "zero_asset_solver_rule": "deterministic_all_cash_bypass",
    "emergency_disclosures_required": [
      "every_slack",
      "binding_trade_limit",
      "solver_status",
      "cash_allocation",
      "estimated_months_to_compliance"
    ]
  },
  "runtime": {
    "python_minimum": "3.11",
    "required_versions": {
      "cvxpy": "1.9.2",
      "cvxpylayers": "1.2.0",
      "clarabel": "0.11.1",
      "scs": "3.2.11",
      "diffcp": "1.1.9"
    },
    "authoritative_device": "cpu",
    "deterministic_threads": 1,
    "forward_solver": "CLARABEL",
    "forward_solver_substitution_permitted": false,
    "differentiable_layer": "CVXPYLayers",
    "differentiation_backend": "diffcp",
    "differentiable_cone_solver": "SCS",
    "gpu_or_mps_authoritative_solve_permitted": false
  },
  "numerical_tolerances": {
    "clarabel_primary": {
      "max_iter": 500,
      "tol_gap_abs": 1e-9,
      "tol_gap_rel": 1e-9,
      "tol_feas": 1e-9,
      "equilibrate_enable": true,
      "iterative_refinement_enable": true
    },
    "clarabel_retry": {
      "max_iter": 2000,
      "tol_gap_abs": 1e-11,
      "tol_gap_rel": 1e-11,
      "tol_feas": 1e-11,
      "equilibrate_enable": true,
      "iterative_refinement_enable": true
    },
    "differentiable_scs_training": {
      "max_iters": 100000,
      "eps_abs": 1e-6,
      "eps_rel": 1e-6,
      "eps_infeas": 1e-7,
      "use_indirect": false,
      "normalize": true,
      "adaptive_scale": false,
      "acceleration_lookback": 0
    },
    "independent_forward_verification": {
      "absolute_constraint_violation_maximum": 5e-8,
      "relative_constraint_violation_maximum": 1e-8,
      "position_and_sign_absolute_violation_maximum": 5e-8,
      "normalized_emergency_violation_worsening_maximum": 5e-8,
      "risk_psd_minimum_eigenvalue": -1e-10,
      "projection_primal_residual_maximum": 5e-8,
      "projection_dual_residual_maximum": 2e-7,
      "projection_stationarity_residual_maximum": 2e-7,
      "repeated_solve_weight_maximum_absolute_difference": 1e-9,
      "repeated_solve_objective_absolute_difference": 1e-10,
      "lexicographic_optimum_lock_absolute": 1e-9
    },
    "differentiable_layer_verification": {
      "training_projection_absolute_constraint_violation_maximum": 5e-5,
      "finite_difference_gradient_absolute_difference_maximum": 5e-4,
      "finite_difference_gradient_relative_difference_maximum": 5e-3,
      "nonfinite_forward_or_gradient_values_permitted": false
    },
    "policy": "Primary and retry solves must return exact solved status; independent verification tolerances are wider than solver tolerances to cover cone canonicalization and floating-point replay but remain economically immaterial. Training-layer tolerances acknowledge iterative differentiation; every inference weight is re-solved and verified with CLARABEL."
  },
  "verification_gates": {
    "upstream_authority_authenticated": true,
    "methodology_hash_authenticated": true,
    "runtime_versions_exact": true,
    "only_synthetic_allocator_cases_executed": true,
    "real_data_payload_rows_read": 0,
    "validation_or_final_rows_read": 0,
    "real_portfolio_weights_or_trades_created": 0,
    "real_pnl_or_performance_rows_created": 0,
    "all_three_architecture_contracts_implemented": true,
    "ordinary_case_slack_count": 0,
    "independent_constraint_recomputation_required": true,
    "candidate_sign_and_reduction_rules_pass": true,
    "all_hard_constraint_families_pass": true,
    "transaction_borrow_and_financing_math_pass": true,
    "borrow_union_reranking_pass": true,
    "ordinary_retry_and_emergency_waterfall_pass": true,
    "emergency_new_or_worsened_violation_count": 0,
    "rank_projection_matches_common_projection": true,
    "decision_focused_forward_projection_matches_common_projection": true,
    "decision_focused_gradient_checks_pass": true,
    "deterministic_replay_pass": true,
    "focused_tests_pass": true,
    "full_repository_regression_pass": true,
    "independent_verification_difference_count": 0
  },
  "publication": {
    "artifact_root": "artifacts/phase_04_models",
    "primary_build_namespace": "allocator_builds",
    "verification_namespace": "allocator_verifications",
    "latest_primary_pointer": "artifacts/phase_04_models/LATEST_ALLOCATOR_PRIMARY.json",
    "latest_verified_pointer": "artifacts/phase_04_models/LATEST_ALLOCATOR_VERIFIED.json",
    "primary_required_files": ["manifest.json", "_SUCCESS.json"],
    "verification_required_files": ["verification_checks.parquet", "verification_report.json", "_SUCCESS.json"],
    "empirical_weight_trade_or_pnl_payload_permitted": false,
    "closed_output_sets_required": true,
