    "accounting_permitted_if_any_strategy_failed": false,
    "strategy_labeled_failures_required": true,
    "allocator_or_economic_rule_changed": false
  },
  "accounting_diagnostics": {
    "attempt_every_active_strategy": true,
    "aggregate_failures_after_all_active_attempts": true,
