    "nav_preserved_bit_for_bit": true,
    "position_value_set_to_exact_zero": true,
    "mark_continuity_identity_removed": true,
    "synthetic_trade_permitted": false,
    "transaction_cost_permitted": false,
    "return_or_price_imputation_permitted": false,
