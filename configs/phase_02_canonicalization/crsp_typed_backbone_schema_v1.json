  "physical_type_contract": {
    "date32": "Arrow date32 with a strict Gregorian YYYY-MM-DD source lexeme",
    "decimal128(38,1)": "Exact Arrow decimal128 with one fractional digit; no binary-float parse or rounding",
    "decimal128(38,2)": "Exact Arrow decimal128 with two fractional digits; no binary-float parse or rounding",
    "decimal128(38,6)": "Exact Arrow decimal128 with six fractional digits; no binary-float parse or rounding",
    "int16": "Signed 16-bit integer",
    "int32": "Signed 32-bit integer",
    "int64": "Signed 64-bit integer",
    "bool": "Non-null Boolean unless a column contract explicitly says otherwise",
    "utf8": "UTF-8 string with decoded source bytes preserved exactly"
  },
  "global_null_and_lexeme_contract": {
    "categorical_and_identifier_strings": "Preserve decoded strings exactly. Empty string remains empty string, literal N/A remains a value, and trimming, case normalization, and null-token normalization are prohibited.",
    "numeric_fields": "Only an empty decoded field becomes null. A nonblank malformed, nonfinite, out-of-range, or non-exactly-representable value is fatal.",
    "optional_dates": "Only an empty decoded field becomes null. A nonblank invalid date is fatal.",
    "required_dates_and_keys": "Blank, invalid, nonpositive required keys, or invalid required dates are fatal.",
    "derived_fields": "A derived numeric is null exactly when a required source operand is null or fails the declared validity predicate; no source row is removed."
  },
  "feature_use_vocabulary": {
    "audit_only_never_feature": "Retained for lineage or reconciliation and prohibited as a model feature.",
    "future_execution_input_not_authorized": "May become an execution input only after the applicable downstream gate; not currently authorized.",
    "future_market_feature_input_not_authorized": "May become a market feature only after feature authorization; not currently authorized.",
    "future_universe_or_constraint_input_not_authorized": "May become a feature, universe, risk, or constraint input only when its column role permits and after every applicable downstream gate; not currently authorized.",
    "key_never_feature": "Join or row key only and always prohibited as a model feature.",
    "quarantined_never_consumer_or_feature": "Return-reconciliation staging only; prohibited from consumer tables, return-history screens, beta, labels, features, portfolios, PnL, and backtests.",
    "quality_only_never_feature": "Quality or validity diagnostic only and prohibited as a model feature."
  },
